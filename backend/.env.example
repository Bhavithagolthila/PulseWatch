DATABASE_URL=sqlite:///./pulsewatch.db
CORS_ORIGINS=http://localhost:5173
REQUEST_TIMEOUT_SECONDS=8
LATENCY_THRESHOLD_MS=1500
MAX_RESPONSE_BYTES=65536
SCHEDULER_ENABLED=true
# Health-check rows older than this are deleted automatically.
RETENTION_DAYS=30

# ---- Login (only you). Choose your own values; login is refused until these are set. ----
AUTH_USERNAME=admin
AUTH_PASSWORD=change-this-long-password
# Signs login tokens. Generate one: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
TOKEN_TTL_HOURS=12

# ---- Email alerts (optional). Example for Gmail: use an App Password, not your normal password. ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# starttls (port 587), ssl (port 465) or none
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
